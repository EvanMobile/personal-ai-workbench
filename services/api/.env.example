# Copy to .env for local overrides. Do not put real secrets in this template.
# PostgreSQL connection (required).
DATABASE_URL=postgresql+psycopg://127.0.0.1:5432/workbench

# Digest provider. P1.M1 defaults to the offline mock provider.
LLM_PROVIDER=mock
LLM_MODEL=mock-digest-v1  # Mock identity is fixed; this value is NOT used to label mock output
DIGEST_PROMPT_VERSION=digest-v0.1

# Real external LLM calls remain disabled until the Owner authorizes them.
ALLOW_REAL_LLM=false

# Local storage for uploaded files and generated artifacts.
WORKBENCH_DATA_DIR=.data
MAX_UPLOAD_BYTES=2097152

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# DingTalk group custom robot. Keep real credentials in this ignored .env only.
DINGTALK_WEBHOOK_URL=
DINGTALK_KEYWORD=钉钉测试
